<Application x:Class="Silk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Silk.Ui"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="Vis" />
        <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft JhengHei UI, Segoe UI</FontFamily>
        <FontFamily x:Key="NumberFont">Bahnschrift, Microsoft YaHei UI</FontFamily>

        <Geometry x:Key="I.Play">M8 5.2 V18.8 L19 12 Z</Geometry>
        <Geometry x:Key="I.Pause">M8 5 V19 M16 5 V19</Geometry>
        <Geometry x:Key="I.Prev">M18.5 6 V18 L9 12 Z M5.5 6 V18</Geometry>
        <Geometry x:Key="I.Next">M5.5 6 V18 L15 12 Z M18.5 6 V18</Geometry>
        <Geometry x:Key="I.List">M4 7 H20 M4 12 H20 M4 17 H13</Geometry>
        <Geometry x:Key="I.Search">M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M16.2 16.2 L20.5 20.5</Geometry>
        <Geometry x:Key="I.Home">M4 11 L12 4 L20 11 V19 A1 1 0 0 1 19 20 H15 V14 H9 V20 H5 A1 1 0 0 1 4 19 Z</Geometry>
        <Geometry x:Key="I.Disc">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 9.5 A2.5 2.5 0 1 0 12 14.5 A2.5 2.5 0 1 0 12 9.5 Z</Geometry>
        <Geometry x:Key="I.Heart">M12 20 C12 20 4.5 15.4 3 10.8 C2 7.4 4.2 5 7 5 C9 5 10.6 6 12 8 C13.4 6 15 5 17 5 C19.8 5 22 7.4 21 10.8 C19.5 15.4 12 20 12 20 Z</Geometry>
        <Geometry x:Key="I.User">M12 4 A4 4 0 1 0 12 12 A4 4 0 1 0 12 4 Z M4.5 20 C5.5 16.5 8.4 15 12 15 C15.6 15 18.5 16.5 19.5 20</Geometry>
        <Geometry x:Key="I.Down">M6 9 L12 15 L18 9</Geometry>
        <Geometry x:Key="I.Back">M15 5.5 L8.5 12 L15 18.5</Geometry>
        <Geometry x:Key="I.Forward">M9 5.5 L15.5 12 L9 18.5</Geometry>
        <Geometry x:Key="I.Sliders">M4 7 H13 M17 7 H20 M13 5 H17 V9 H13 Z M4 17 H7 M11 17 H20 M7 15 H11 V19 H7 Z</Geometry>
        <Geometry x:Key="I.Repeat">M17 3 L21 7 L17 11 M3 11 V9.5 A2.5 2.5 0 0 1 5.5 7 H21 M7 21 L3 17 L7 13 M21 13 V14.5 A2.5 2.5 0 0 1 18.5 17 H3</Geometry>
        <Geometry x:Key="I.RepeatOne">M17 3 L21 7 L17 11 M3 11 V9.5 A2.5 2.5 0 0 1 5.5 7 H21 M7 21 L3 17 L7 13 M21 13 V14.5 A2.5 2.5 0 0 1 18.5 17 H3 M11 11 L12.5 10 V14</Geometry>
        <Geometry x:Key="I.Shuffle">M16 3 H21 V8 M3 20 L21 3 M21 16 V21 H16 M15 15 L21 21 M3 4 L9 10</Geometry>
        <Geometry x:Key="I.Close">M6 6 L18 18 M18 6 L6 18</Geometry>
        <Geometry x:Key="I.Min">M5 12 H19</Geometry>
        <Geometry x:Key="I.Max">M6 6 H18 V18 H6 Z</Geometry>
        <Geometry x:Key="I.Expand">M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15</Geometry>
        <Geometry x:Key="I.Shrink">M9 4 V9 H4 M15 4 V9 H20 M20 15 H15 V20 M4 15 H9 V20</Geometry>
        <Geometry x:Key="I.Grip">M9 6 H9.01 M15 6 H15.01 M9 12 H9.01 M15 12 H15.01 M9 18 H9.01 M15 18 H15.01</Geometry>
        <Geometry x:Key="I.Restore">M6 9 H15 V18 H6 Z M9 9 V6 H18 V15 H15</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
        </Style>

        <Storyboard x:Key="PressIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To=".93" Duration="0:0:0.07" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To=".93" Duration="0:0:0.07" />
        </Storyboard>
        <Storyboard x:Key="PressOut">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><BackEase Amplitude=".5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><BackEase Amplitude=".5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="BorderBrush" Value="{x:Static ui:Theme.Fg45}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="RenderTransformOrigin" Value=".5,.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="Transparent" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Path x:Name="Glyph" Style="{StaticResource IconPath}" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="Stroke" Value="{x:Static ui:Theme.Fg}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="StrokeButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="Transparent" />
                            <Path Style="{StaticResource IconPath}" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{x:Static ui:Theme.Fg24}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfArrow" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="{x:Static ui:Theme.Drawer}" Stroke="{x:Static ui:Theme.Fg24}" StrokeThickness="1" />
                            <Path Style="{StaticResource IconPath}" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Stroke" Value="{x:Static ui:Theme.Fg}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ui:HeartButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:HeartButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="Transparent" />
                            <Path x:Name="Glyph" Style="{StaticResource IconPath}" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  Data="{StaticResource I.Heart}" Fill="Transparent" RenderTransformOrigin=".5,.55">
                                <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{x:Static ui:Theme.Fg24}" /></Trigger>
                            <Trigger Property="IsLiked" Value="True">
                                <Setter TargetName="Glyph" Property="Fill" Value="{x:Static ui:Theme.Fg}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From=".72" To="1" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="1.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From=".72" To="1" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="1.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg70}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <Path Style="{StaticResource IconPath}" StrokeThickness="1.15" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" />
                                <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <Path x:Name="G" Style="{StaticResource IconPath}" StrokeThickness="1.15" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="G" Property="Stroke" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="16" Background="{x:Static ui:Theme.Fg07}" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg24}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{x:Static ui:Theme.Fg}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="16" Height="32" Padding="15,0" Background="{x:Static ui:Theme.Fg07}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg24}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bg" CornerRadius="16" Height="32" Padding="15,0" Background="{x:Static ui:Theme.Fg07}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg24}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg07}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTrackButton" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="30">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg07}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderPart}" Background="{x:Static ui:Theme.Fg}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderPart}" Background="{x:Static ui:Theme.Fg24}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{x:Static ui:Theme.Fg}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="17" Height="34" Padding="18,0" Background="{x:Static ui:Theme.Fg12}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg24}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value=".5,.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Opacity="1" x:Name="Body" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".88" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To=".975" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To=".975" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="CaretBrush" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="SelectionBrush" Value="{x:Static ui:Theme.Fg45}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" CornerRadius="19" Height="38" Background="{x:Static ui:Theme.Fg12}" BorderBrush="Transparent" BorderThickness="1.2">
                            <Grid Margin="14,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{x:Static ui:Theme.Fg70}" Data="{StaticResource I.Search}" />
                                <TextBlock x:Name="Hint" Grid.Column="1" Margin="10,0,0,0" Text="搜尋歌曲、歌手" Foreground="{x:Static ui:Theme.Fg70}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg24}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{x:Static ui:Theme.Fg70}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Width="4" CornerRadius="2" Background="{x:Static ui:Theme.Fg24}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{x:Static ui:Theme.Fg45}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus share the drawer's colour and the app's type, instead of the system look. -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="0,0,12,12" Padding="6" CornerRadius="14" Background="{x:Static ui:Theme.Drawer}" BorderBrush="{x:Static ui:Theme.Fg12}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity=".32" Color="Black" /></Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9" Padding="14,8,24,8" MinWidth="164">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bg" Property="Background" Value="{x:Static ui:Theme.Fg12}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,5" Background="{x:Static ui:Theme.Fg12}" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SongMenu" x:Shared="False">
            <MenuItem Header="播放" Click="OnMenuPlay" />
            <MenuItem Header="下一首播放" Click="OnMenuPlayNext" />
            <MenuItem Header="加入播放清單" Click="OnMenuAddToQueue" />
            <Separator />
            <MenuItem Header="{Binding LikeMenuText}" Click="OnMenuLike" />
            <Separator />
            <MenuItem Header="前往專輯" Click="OnMenuAlbum" />
            <MenuItem Header="前往歌手" Click="OnMenuSinger" />
        </ContextMenu>

        <ContextMenu x:Key="QueueMenu" x:Shared="False">
            <MenuItem Header="播放" Click="OnMenuPlay" />
            <MenuItem Header="下一首播放" Click="OnMenuPlayNext" />
            <MenuItem Header="從清單移除" Click="OnMenuRemove" />
            <Separator />
            <MenuItem Header="{Binding LikeMenuText}" Click="OnMenuLike" />
            <Separator />
            <MenuItem Header="前往專輯" Click="OnMenuAlbum" />
            <MenuItem Header="前往歌手" Click="OnMenuSinger" />
        </ContextMenu>

        <DataTemplate x:Key="SongRowTemplate">
            <Grid x:Name="RowRoot" Background="Transparent" ContextMenu="{StaticResource SongMenu}">
                <Button Style="{StaticResource PlainButton}" Click="OnSongRowClick" Height="58" AutomationProperties.Name="{Binding Song.Title}">
                    <Grid Margin="10,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Num" Text="{Binding Number}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{x:Static ui:Theme.Fg45}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="9" ui:Cover.Decode="128" ui:Cover.Url="{Binding Song.Cover}" />
                        <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Name" Text="{Binding Song.Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Song.Artist}" FontSize="12" Margin="0,2,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Song.Album}" FontSize="12" Foreground="{x:Static ui:Theme.Fg70}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,44,0" />
                        <TextBlock Grid.Column="4" Text="{Binding Song.DurationText}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{x:Static ui:Theme.Fg70}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Button>
                <ui:HeartButton x:Name="Heart" Width="34" Height="34" FontSize="15" HorizontalAlignment="Right" Margin="0,0,62,0" Opacity="0"
                                IsLiked="{Binding IsLiked}" Click="OnRowLikeClick" AutomationProperties.Name="{Binding LikeLabel}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Num" Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLiked}" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></DataTrigger>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></Trigger>
                <Trigger SourceName="Heart" Property="IsKeyboardFocused" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CompactRowTemplate">
            <Grid x:Name="RowRoot" Background="Transparent" Margin="0,0,14,2" ContextMenu="{StaticResource SongMenu}">
                <Button Style="{StaticResource PlainButton}" Click="OnSongRowClick" Height="56" AutomationProperties.Name="{Binding Song.Title}">
                    <Grid Margin="8,0,42,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10" ui:Cover.Decode="128" ui:Cover.Url="{Binding Song.Cover}" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Name" Text="{Binding Song.Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Song.Artist}" FontSize="12" Margin="0,2,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
                <ui:HeartButton x:Name="Heart" Width="34" Height="34" FontSize="15" HorizontalAlignment="Right" Margin="0,0,6,0" Opacity="0"
                                IsLiked="{Binding IsLiked}" Click="OnRowLikeClick" AutomationProperties.Name="{Binding LikeLabel}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Name" Property="FontWeight" Value="Bold" /></DataTrigger>
                <DataTrigger Binding="{Binding IsLiked}" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></DataTrigger>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></Trigger>
                <Trigger SourceName="Heart" Property="IsKeyboardFocused" Value="True"><Setter TargetName="Heart" Property="Opacity" Value="1" /></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HeroCardTemplate">
            <Button Style="{StaticResource CardButton}" Width="{Binding Width}" Margin="0,0,16,0" Click="OnCardClick" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <Border Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CornerRadius="24" ui:Cover.Url="{Binding Cover}" />
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="3,11,3,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="3,2,3,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SingerTileTemplate">
            <Button Style="{StaticResource CardButton}" Width="104" Margin="0,0,14,0" Click="OnCardClick" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <Border Width="96" Height="96" CornerRadius="48" ui:Cover.Decode="240" ui:Cover.Url="{Binding Cover}" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,1,0,0" TextAlignment="Center" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource CardButton}" Width="136" Margin="0,0,14,0" Click="OnCardClick" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <Border Height="136" CornerRadius="18" ui:Cover.Decode="360" ui:Cover.Url="{Binding Cover}" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="2,8,2,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="2,1,2,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="QueueRowTemplate">
            <Grid x:Name="RowRoot" Background="Transparent" ContextMenu="{StaticResource QueueMenu}">
                <Button Style="{StaticResource PlainButton}" Click="OnQueueRowClick" Height="56" AutomationProperties.Name="{Binding Song.Title}">
                    <Grid Margin="8,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="9" ui:Cover.Decode="128" ui:Cover.Url="{Binding Song.Cover}" />
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Name" Text="{Binding Song.Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Song.Artist}" FontSize="12" Margin="0,1,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="Duration" Grid.Column="2" Text="{Binding Song.DurationText}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{x:Static ui:Theme.Fg70}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Button>
                <!-- Shown on hover: remove the song, or drag the handle to move it. -->
                <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0">
                    <Button Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Close}" Width="30" Height="30" FontSize="10" Click="OnQueueRemove"
                            AutomationProperties.Name="{Binding Song.Title, StringFormat=從清單移除 {0}}" ToolTip="從清單移除" />
                    <Border x:Name="Grip" Width="26" Height="40" Background="Transparent" Cursor="SizeAll" ToolTip="拖動排序" PreviewMouseLeftButtonDown="OnQueueGripDown">
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" StrokeThickness="2.6" Data="{StaticResource I.Grip}" />
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tools" Property="Opacity" Value="1" />
                    <Setter TargetName="Duration" Property="Opacity" Value="0" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="GridCardTemplate">
            <Button Style="{StaticResource CardButton}" Width="164" Margin="0,0,16,20" Click="OnCardClick" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <Border Height="164" CornerRadius="20" ui:Cover.Decode="360" ui:Cover.Url="{Binding Cover}" />
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="2,9,2,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="2,2,2,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- The top of a singer or album page; it is the first item of the song list and scrolls with it. -->
        <DataTemplate x:Key="DetailHeaderTemplate">
            <StackPanel Margin="10,0,14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="140" Height="140" VerticalAlignment="Top" CornerRadius="{Binding CoverCorner}" ui:Cover.Decode="320" ui:Cover.Url="{Binding Detail.Cover}" />
                    <StackPanel Grid.Column="1" Margin="22,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Detail.Meta}" FontSize="13" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasMeta, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Detail.Description}" FontSize="13" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="{Binding DescriptionHeight}" Visibility="{Binding HasDescription, Converter={StaticResource Vis}}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource PillTextButton}" Content="播放全部" Margin="0,0,8,6" Click="OnDetailPlayAll" />
                            <Button Style="{StaticResource PillTextButton}" Content="{Binding ExpandText}" Margin="0,0,8,6" Click="OnDetailExpand"
                                    Visibility="{Binding CanExpand, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding ExpandText, StringFormat={}{0}簡介}" />
                            <Button Style="{StaticResource PillTextButton}" Content="{Binding SingerText}" Margin="0,0,8,6" Click="OnDetailSinger"
                                    Visibility="{Binding HasSinger, Converter={StaticResource Vis}}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
                <ui:Shelf Title="專輯" Margin="0,22,0,0" ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource TileTemplate}"
                          Visibility="{Binding HasAlbums, Converter={StaticResource Vis}}" />
                <TextBlock Text="熱門歌曲" FontSize="17" FontWeight="SemiBold" Margin="2,22,0,4" Visibility="{Binding ShowSongHeading, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SingerHeaderTemplate">
            <StackPanel Margin="10,0,0,4">
                <ui:Shelf Title="歌手" ArrowTop="28" ItemsSource="{Binding Singers}" ItemTemplate="{StaticResource SingerTileTemplate}" />
                <TextBlock Text="歌曲" FontSize="17" FontWeight="SemiBold" Margin="2,18,0,4" />
            </StackPanel>
        </DataTemplate>

        <ui:SongListTemplates x:Key="SongListTemplates" Row="{StaticResource SongRowTemplate}"
                              Detail="{StaticResource DetailHeaderTemplate}" Singers="{StaticResource SingerHeaderTemplate}" />

        <Style x:Key="RowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{x:Static ui:Theme.Fg}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
