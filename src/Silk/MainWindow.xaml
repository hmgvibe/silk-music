<Window x:Class="Silk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Silk.Ui"
        Title="絲音"
        Width="1180" Height="740" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static ui:Theme.Base}"
        Foreground="{x:Static ui:Theme.Fg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Rectangle x:Name="SilkSurface" Fill="{x:Static ui:Theme.Base}" IsHitTestVisible="False" />

        <!-- Home -->
        <Grid x:Name="HomeLayer" Margin="16,34,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Tag="{StaticResource I.Sliders}" Content="設定" Checked="OnNavChecked"
                         VerticalAlignment="Bottom" Margin="2,0,0,0" AutomationProperties.Name="設定" />
            <StackPanel Margin="2,4,0,0">
                <Button x:Name="ProfileButton" Style="{StaticResource PlainButton}" Click="OnProfileClick" Margin="-6,0,-6,20" Padding="0" AutomationProperties.Name="帳號">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="54" Height="54">
                            <Ellipse Fill="{x:Static ui:Theme.Fg24}" />
                            <Path Style="{StaticResource IconPath}" Width="22" Height="22" Stroke="{x:Static ui:Theme.Fg}" Data="{StaticResource I.User}" />
                            <Border CornerRadius="27" ui:Cover.Decode="160" ui:Cover.Url="{Binding Avatar}" Visibility="{Binding IsSignedIn, Converter={StaticResource Vis}}" Background="Transparent" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserSubtitle}" FontSize="12" Margin="0,2,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileMenu">
                            <MenuItem Header="登出" Click="OnSignOutClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" GroupName="Nav" Tag="{StaticResource I.Home}" Content="首頁" Checked="OnNavChecked" AutomationProperties.Name="首頁" />
                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" GroupName="Nav" Tag="{StaticResource I.Disc}" Content="音樂庫" Checked="OnNavChecked" AutomationProperties.Name="音樂庫" />
                <RadioButton x:Name="NavLiked" Style="{StaticResource NavButton}" GroupName="Nav" Tag="{StaticResource I.Heart}" Content="喜歡" Checked="OnNavChecked" AutomationProperties.Name="喜歡" />
            </StackPanel>

            <Border x:Name="MainPanel" Grid.Column="2" CornerRadius="30" Background="{x:Static ui:Theme.Panel}" SizeChanged="OnPanelSizeChanged">
                <Grid Margin="30,24,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Back}" Width="36" Height="36" FontSize="14" Margin="-8,0,8,0" Click="OnBackClick"
                                Visibility="{Binding CanGoBack, Converter={StaticResource Vis}}" AutomationProperties.Name="返回" />
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PageSubtitle}" FontSize="14" Margin="0,3,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBox x:Name="SearchInput" Grid.Column="2" Style="{StaticResource SearchBox}" VerticalAlignment="Top" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜尋" />
                        <!-- Recent searches, shown while the empty search box has focus. -->
                        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=SearchInput}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True"
                               StaysOpen="True" Width="{Binding ActualWidth, ElementName=SearchInput}">
                            <Border Margin="0,0,0,12" Padding="16,12,10,6" CornerRadius="18" Background="{x:Static ui:Theme.Drawer}" BorderBrush="{x:Static ui:Theme.Fg12}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="最近搜尋" FontSize="13" Foreground="{x:Static ui:Theme.Fg70}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource PillTextButton}" Content="清除" Focusable="False" HorizontalAlignment="Right" Click="OnClearHistory"
                                                AutomationProperties.Name="清除搜尋紀錄" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SearchHistory}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PillTextButton}" Content="{Binding}" Focusable="False" Margin="0,0,8,8" Click="OnHistoryClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid x:Name="PageHost" Grid.Row="1">
                        <ScrollViewer x:Name="HomeScroller" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsCardsView, Converter={StaticResource Vis}}">
                            <StackPanel Margin="0,0,0,10">
                                <ui:Shelf x:Name="HeroShelf" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource HeroCardTemplate}" />

                                <StackPanel Margin="0,26,0,0" Visibility="{Binding ShowDailySection, Converter={StaticResource Vis}}">
                                    <Grid Margin="2,0,24,10">
                                        <TextBlock Text="今日推薦" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource PillTextButton}" Content="播放全部" HorizontalAlignment="Right" Click="OnPlayRecommended" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource CompactRowTemplate}" Margin="-8,0,10,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <ui:Shelf Title="最近播放" Margin="0,26,0,0" ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource TileTemplate}"
                                          Visibility="{Binding ShowRecentSection, Converter={StaticResource Vis}}" />
                                <ui:Shelf Title="排行榜" Margin="0,26,0,0" ItemsSource="{Binding Charts}" ItemTemplate="{StaticResource TileTemplate}"
                                          Visibility="{Binding ShowChartsSection, Converter={StaticResource Vis}}" />
                                <ui:Shelf Title="新碟上架" Margin="0,26,0,0" ItemsSource="{Binding NewAlbums}" ItemTemplate="{StaticResource TileTemplate}"
                                          Visibility="{Binding ShowAlbumsSection, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsSettingsView, Converter={StaticResource Vis}}">
                            <StackPanel Margin="2,0,24,16">
                                <StackPanel.Resources>
                                    <Style x:Key="Group" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,14,0,14" />
                                    </Style>
                                    <Style x:Key="Label" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{x:Static ui:Theme.Fg70}" /><Setter Property="Margin" Value="0,6,0,0" />
                                    </Style>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource ChipButton}">
                                        <Setter Property="Margin" Value="0,0,8,8" /><EventSetter Event="Checked" Handler="OnSettingChecked" />
                                    </Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource ChipCheck}">
                                        <EventSetter Event="Checked" Handler="OnSectionChanged" /><EventSetter Event="Unchecked" Handler="OnSectionChanged" />
                                    </Style>
                                    <Style TargetType="WrapPanel"><Setter Property="Grid.Column" Value="1" /></Style>
                                    <Style TargetType="Grid"><Setter Property="Margin" Value="0,0,0,6" /></Style>
                                </StackPanel.Resources>

                                <TextBlock Text="外觀" Style="{StaticResource Group}" Margin="0,0,0,14" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="絲綢光效" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Glow" Tag="Glow:0" Content="關閉" /><RadioButton GroupName="Glow" Tag="Glow:1" Content="柔和" /><RadioButton GroupName="Glow" Tag="Glow:2" Content="適中" /><RadioButton GroupName="Glow" Tag="Glow:3" Content="明顯" /></WrapPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="視窗顏色" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Color" Tag="Color:0" Content="跟隨封面" /><RadioButton GroupName="Color" Tag="Color:1" Content="固定深色" /><RadioButton GroupName="Color" Tag="Color:2" Content="固定淺色" /></WrapPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="面板質感" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Panel" Tag="Panel:0" Content="通透" /><RadioButton GroupName="Panel" Tag="Panel:1" Content="沉穩" /></WrapPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="波形高度" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Wave" Tag="Wave:0" Content="低" /><RadioButton GroupName="Wave" Tag="Wave:1" Content="標準" /><RadioButton GroupName="Wave" Tag="Wave:2" Content="高" /></WrapPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="進度條" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="WaveStyle" Tag="WaveStyle:0" Content="波紋" /><RadioButton GroupName="WaveStyle" Tag="WaveStyle:1" Content="條形" /><RadioButton GroupName="WaveStyle" Tag="WaveStyle:2" Content="普通" /></WrapPanel>
                                </Grid>

                                <TextBlock Text="播放" Style="{StaticResource Group}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="音質" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Quality" Tag="Quality:0" Content="最高可用" /><RadioButton GroupName="Quality" Tag="Quality:1" Content="320K" /><RadioButton GroupName="Quality" Tag="Quality:2" Content="128K" /></WrapPanel>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="播放順序" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Mode" Tag="Mode:0" Content="清單循環" /><RadioButton GroupName="Mode" Tag="Mode:1" Content="單曲循環" /><RadioButton GroupName="Mode" Tag="Mode:2" Content="隨機播放" /></WrapPanel>
                                </Grid>

                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="關閉視窗時" Style="{StaticResource Label}" />
                                    <WrapPanel><RadioButton GroupName="Close" Tag="Close:0" Content="背景播放" /><RadioButton GroupName="Close" Tag="Close:1" Content="結束程式" /></WrapPanel>
                                </Grid>

                                <TextBlock Text="首頁顯示" Style="{StaticResource Group}" />
                                <WrapPanel><CheckBox Tag="Daily" Content="今日推薦" /><CheckBox Tag="Recent" Content="最近播放" /><CheckBox Tag="Charts" Content="排行榜" /><CheckBox Tag="Albums" Content="新碟上架" /></WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsGridView, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding Library}" ItemTemplate="{StaticResource GridCardTemplate}" Focusable="False" Margin="0,0,16,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Visibility="{Binding IsSongsView, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="SearchTabs" Margin="0,0,0,12" Visibility="{Binding ShowSearchTabs, Converter={StaticResource Vis}}">
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="SearchTab" Tag="0" Content="歌曲" Margin="0,0,8,0" Checked="OnSearchTabChecked" />
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="SearchTab" Tag="1" Content="專輯" Margin="0,0,8,0" Checked="OnSearchTabChecked" />
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="SearchTab" Tag="2" Content="歌單" Margin="0,0,8,0" Checked="OnSearchTabChecked" />
                            </WrapPanel>
                            <!-- Headers (singer, album or matching singers) and songs share one virtualized list. -->
                            <ListBox x:Name="SongList" Grid.Row="1" Style="{StaticResource RowList}" ItemTemplateSelector="{StaticResource SongListTemplates}" Margin="-10,0,12,0"
                                     Visibility="{Binding ShowSongList, Converter={StaticResource Vis}}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding ShowCollectionGrid, Converter={StaticResource Vis}}">
                                <ItemsControl ItemsSource="{Binding SearchCollections}" ItemTemplate="{StaticResource GridCardTemplate}" Focusable="False" Margin="0,0,16,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,30,30" Visibility="{Binding IsLoginView, Converter={StaticResource Vis}}">
                            <Border Width="232" Height="232" CornerRadius="26" Background="White" Padding="16">
                                <Image Source="{Binding QrImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" AutomationProperties.Name="登入碼" />
                            </Border>
                            <TextBlock Text="{Binding LoginHint}" FontSize="14" Margin="0,16,0,14" HorizontalAlignment="Center" TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="ChannelQq" Style="{StaticResource ChipButton}" GroupName="Channel" Content="手機 QQ" Tag="0" Checked="OnChannelChecked" IsChecked="True" />
                                <RadioButton x:Name="ChannelWechat" Style="{StaticResource ChipButton}" GroupName="Channel" Content="微信" Tag="1" Checked="OnChannelChecked" />
                                <RadioButton x:Name="ChannelApp" Style="{StaticResource ChipButton}" GroupName="Channel" Content="QQ 音樂" Tag="2" Checked="OnChannelChecked" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,30,30" Visibility="{Binding IsMessageView, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Message}" FontSize="15" Foreground="{x:Static ui:Theme.Fg70}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                            <Button Style="{StaticResource PillTextButton}" Content="再試一次" Margin="0,16,0,0" HorizontalAlignment="Center" Click="OnRetryClick"
                                    Visibility="{Binding CanRetry, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Floating player pill -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="36" Background="{x:Static ui:Theme.Panel}">
                <Grid Margin="10,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PillTrack" Style="{StaticResource PillTrackButton}" Height="60" Margin="-4,0,0,0" Click="OnOpenPlayer" AutomationProperties.Name="開啟播放器">
                        <Grid Margin="4,0,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PillCover" Width="52" Height="52" CornerRadius="26" ui:Cover.Keep="True" ui:Cover.Url="{Binding CurrentCover}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentArtist}" FontSize="12" Margin="0,1,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ui:WaveformView x:Name="PillWave" Grid.Column="1" Margin="18,12,24,0" VerticalAlignment="Center" Height="{Binding PillWaveHeight}" Compact="True" Bars="{Binding WaveBars}" Plain="{Binding WavePlain}" HasTrack="{Binding HasTrack}" Heights="{Binding WaveHeights}" Progress="{Binding Progress}" AutomationProperties.Name="播放進度" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:HeartButton Margin="0,0,10,0" IsLiked="{Binding CurrentLiked}" Click="OnLikeCurrent" AutomationProperties.Name="{Binding LikeLabel}"
                                        Visibility="{Binding HasTrack, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource RoundButton}" Tag="{StaticResource I.Prev}" FontSize="13" Click="OnPrevious" AutomationProperties.Name="上一首" />
                        <Button x:Name="PillPlay" Style="{StaticResource RoundButton}" Width="50" Height="50" FontSize="17" BorderThickness="1.5" Margin="9,0" Tag="{StaticResource I.Play}" Click="OnToggle" AutomationProperties.Name="播放或暫停" />
                        <Button Style="{StaticResource RoundButton}" Tag="{StaticResource I.Next}" FontSize="13" Click="OnNext" AutomationProperties.Name="下一首" />
                        <Button Style="{StaticResource StrokeButton}" Tag="{StaticResource I.List}" FontSize="16" Margin="9,0,0,0" Click="OnQueueOpen" AutomationProperties.Name="播放清單" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Now playing -->
        <Grid x:Name="PlayerLayer" Visibility="Collapsed" SizeChanged="OnPlayerSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*" />
                <ColumnDefinition Width="54*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="{Binding PlayerWaveHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17*" />
                    <ColumnDefinition Width="74*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8">
                    <TextBlock Text="{Binding PositionText}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{x:Static ui:Theme.Fg}" />
                    <TextBlock Text="{Binding DurationText, StringFormat=' / {0}'}" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{x:Static ui:Theme.Fg70}" />
                </StackPanel>
                <ui:WaveformView x:Name="PlayerWave" Grid.Column="1" Bars="{Binding WaveBars}" Plain="{Binding WavePlain}" HasTrack="{Binding HasTrack}" Heights="{Binding WaveHeights}" Progress="{Binding Progress}" AutomationProperties.Name="播放進度" />
            </Grid>

            <StackPanel x:Name="PlayerLeft" SizeChanged="OnPlayerLeftSizeChanged" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,40,0,0">
                <Border x:Name="PlayerCover" Width="340" Height="340" CornerRadius="38" ui:Cover.Keep="True" ui:Cover.Url="{Binding CurrentCover}" />
                <TextBlock Text="{Binding CurrentTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Width="{Binding ActualWidth, ElementName=PlayerCover}" />
                <TextBlock Text="{Binding CurrentArtist}" FontSize="13" Margin="0,3,0,0" Foreground="{x:Static ui:Theme.Fg70}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Width="{Binding ActualWidth, ElementName=PlayerCover}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <ui:HeartButton Width="44" Height="44" FontSize="19" Margin="0,0,14,0" IsLiked="{Binding CurrentLiked}" Click="OnLikeCurrent" AutomationProperties.Name="{Binding LikeLabel}" />
                    <Button Style="{StaticResource RoundButton}" Tag="{StaticResource I.Prev}" Width="44" Height="44" Click="OnPrevious" AutomationProperties.Name="上一首" />
                    <Button x:Name="PlayerPlay" Style="{StaticResource RoundButton}" Width="60" Height="60" FontSize="20" BorderThickness="1.6" Margin="16,0" Tag="{StaticResource I.Play}" Click="OnToggle" AutomationProperties.Name="播放或暫停" />
                    <Button Style="{StaticResource RoundButton}" Tag="{StaticResource I.Next}" Width="44" Height="44" Click="OnNext" AutomationProperties.Name="下一首" />
                    <Button x:Name="ModeButton" Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Repeat}" Width="44" Height="44" FontSize="18" Margin="14,0,0,0" Click="OnCycleMode" AutomationProperties.Name="{Binding ModeLabel}" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="LyricArea" Grid.Column="1" Margin="10,62,64,6" SizeChanged="OnLyricAreaChanged">
                <Grid x:Name="LyricViewport" VerticalAlignment="Center">
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop x:Name="LyricFadeTop" Offset=".1" Color="#FF000000" />
                            <GradientStop x:Name="LyricFadeBottom" Offset=".9" Color="#FF000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <ui:LyricView x:Name="LyricView" ClipToBounds="True" AutomationProperties.Name="歌詞" />
                </Grid>
            </Grid>

            <!-- Bottom-left, mirroring the queue button; the options drawer also opens from this side. -->
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource RoundButton}" Tag="{StaticResource I.Sliders}" Width="46" Height="46" FontSize="16"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,18" Click="OnPlayerOptionsOpen" AutomationProperties.Name="播放器設定" />
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundButton}" Tag="{StaticResource I.List}" Width="46" Height="46" FontSize="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Click="OnQueueOpen" AutomationProperties.Name="播放清單" />
            <Button Grid.ColumnSpan="2" Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Down}" Width="38" Height="38" FontSize="15"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,6,0,0" Click="OnClosePlayer" AutomationProperties.Name="收合播放器" />
            <Button x:Name="FullscreenButton" Grid.ColumnSpan="2" Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Expand}" Width="38" Height="38" FontSize="14"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,6,0,0" Click="OnFullscreenClick" AutomationProperties.Name="全屏" ToolTip="全屏 (F11)" />
        </Grid>

        <Canvas x:Name="FlyLayer" IsHitTestVisible="False">
            <Border x:Name="FlyCover" Visibility="Collapsed" ui:Cover.Keep="True" ui:Cover.Url="{Binding CurrentCover}" />
        </Canvas>

        <!-- Player options: opens from the left so the lyrics stay visible while adjusting them -->
        <Grid x:Name="PlayerOptionsLayer" Visibility="Collapsed">
            <Rectangle Fill="#01000000" MouseLeftButtonDown="OnPlayerOptionsScrim" />
            <Border x:Name="PlayerOptionsDrawer" Width="372" HorizontalAlignment="Left" Margin="10,36,0,10" CornerRadius="26" Background="{x:Static ui:Theme.Drawer}">
                <Border.RenderTransform><TranslateTransform x:Name="PlayerOptionsShift" /></Border.RenderTransform>
                <Grid Margin="22,18,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="播放器設定" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Close}" Width="34" Height="34" FontSize="11" HorizontalAlignment="Right" Click="OnPlayerOptionsClose" AutomationProperties.Name="關閉播放器設定" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="PlayerOptionsPanel" Margin="0,0,14,6">
                            <StackPanel.Resources>
                                <Style x:Key="Head" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{x:Static ui:Theme.Fg70}" /><Setter Property="Margin" Value="0,12,0,8" /></Style>
                                <Style x:Key="Name" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /></Style>
                                <Style x:Key="Amount" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontFamily" Value="{StaticResource NumberFont}" /><Setter Property="Foreground" Value="{x:Static ui:Theme.Fg70}" /><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                                <Style TargetType="Slider" BasedOn="{StaticResource LineSlider}"><Setter Property="Margin" Value="0,2,0,10" /></Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource ChipButton}"><Setter Property="Margin" Value="0,0,8,8" /><EventSetter Event="Checked" Handler="OnSettingChecked" /></Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource ChipCheck}"><EventSetter Event="Checked" Handler="OnSectionChanged" /><EventSetter Event="Unchecked" Handler="OnSectionChanged" /></Style>
                            </StackPanel.Resources>

                            <TextBlock Text="歌詞" Style="{StaticResource Head}" Margin="0,2,0,10" />
                            <Grid><TextBlock Text="顯示行數" Style="{StaticResource Name}" /><TextBlock Text="{Binding LyricLines, StringFormat={}{0:0} 行}" Style="{StaticResource Amount}" /></Grid>
                            <Slider Minimum="3" Maximum="15" TickFrequency="2" Value="{Binding LyricLines}" AutomationProperties.Name="顯示行數" />
                            <Grid><TextBlock Text="字體大小" Style="{StaticResource Name}" /><TextBlock Text="{Binding LyricFontSize, StringFormat={}{0:0}}" Style="{StaticResource Amount}" /></Grid>
                            <Slider Minimum="14" Maximum="34" TickFrequency="1" Value="{Binding LyricFontSize}" AutomationProperties.Name="字體大小" />
                            <Grid><TextBlock Text="目前行放大" Style="{StaticResource Name}" /><TextBlock Text="{Binding LyricScale, StringFormat={}{0:0}%}" Style="{StaticResource Amount}" /></Grid>
                            <Slider Minimum="100" Maximum="170" TickFrequency="5" Value="{Binding LyricScale}" AutomationProperties.Name="目前行放大" />
                            <Grid><TextBlock Text="行距" Style="{StaticResource Name}" /><TextBlock Text="{Binding LyricSpacing, StringFormat={}{0:0.0} 倍}" Style="{StaticResource Amount}" /></Grid>
                            <Slider Minimum="1.6" Maximum="4" TickFrequency=".1" Value="{Binding LyricSpacing}" AutomationProperties.Name="行距" />
                            <Grid><TextBlock Text="其他行亮度" Style="{StaticResource Name}" /><TextBlock Text="{Binding LyricDim, StringFormat={}{0:0}%}" Style="{StaticResource Amount}" /></Grid>
                            <Slider Minimum="15" Maximum="100" TickFrequency="5" Value="{Binding LyricDim}" AutomationProperties.Name="其他行亮度" />

                            <TextBlock Text="對齊方式" Style="{StaticResource Head}" />
                            <WrapPanel><RadioButton GroupName="AlignOption" Tag="Align:0" Content="靠左" /><RadioButton GroupName="AlignOption" Tag="Align:1" Content="置中" /><RadioButton GroupName="AlignOption" Tag="Align:2" Content="靠右" /><CheckBox Tag="Bold" Content="目前行加粗" /></WrapPanel>

                            <TextBlock Text="效果" Style="{StaticResource Head}" />
                            <WrapPanel><CheckBox Tag="Blur" Content="遠處模糊" /></WrapPanel>

                            <TextBlock Text="封面大小" Style="{StaticResource Head}" />
                            <WrapPanel><RadioButton GroupName="CoverOption" Tag="Cover:0" Content="小" /><RadioButton GroupName="CoverOption" Tag="Cover:1" Content="標準" /><RadioButton GroupName="CoverOption" Tag="Cover:2" Content="大" /></WrapPanel>

                            <TextBlock Text="波形高度" Style="{StaticResource Head}" />
                            <WrapPanel><RadioButton GroupName="WaveOption" Tag="Wave:0" Content="低" /><RadioButton GroupName="WaveOption" Tag="Wave:1" Content="標準" /><RadioButton GroupName="WaveOption" Tag="Wave:2" Content="高" /></WrapPanel>

                            <TextBlock Text="進度條" Style="{StaticResource Head}" />
                            <WrapPanel><RadioButton GroupName="WaveStyleOption" Tag="WaveStyle:0" Content="波紋" /><RadioButton GroupName="WaveStyleOption" Tag="WaveStyle:1" Content="條形" /><RadioButton GroupName="WaveStyleOption" Tag="WaveStyle:2" Content="普通" /></WrapPanel>

                            <Button Style="{StaticResource PillTextButton}" Content="恢復預設" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnPlayerOptionsReset" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Queue drawer -->
        <Grid x:Name="QueueLayer" Visibility="Collapsed">
            <Rectangle x:Name="QueueScrim" Fill="#01000000" MouseLeftButtonDown="OnQueueScrimClick" />
            <Border x:Name="QueueDrawer" Width="372" HorizontalAlignment="Right" Margin="0,36,10,10" CornerRadius="26" Background="{x:Static ui:Theme.Drawer}">
                <Border.RenderTransform><TranslateTransform x:Name="QueueShift" /></Border.RenderTransform>
                <Grid Margin="20,18,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="播放清單" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Queue.Count}" FontFamily="{StaticResource NumberFont}" FontSize="13" Margin="9,0,0,0" Foreground="{x:Static ui:Theme.Fg70}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillTextButton}" Content="清空" Margin="0,0,8,0" VerticalAlignment="Center" Click="OnQueueClear" AutomationProperties.Name="清空播放清單" />
                            <Button Style="{StaticResource StrokeButton}" Tag="{StaticResource I.Close}" Width="34" Height="34" FontSize="11" Click="OnQueueClose" AutomationProperties.Name="關閉播放清單" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="QueueList" Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueRowTemplate}"
                             AllowDrop="True" DragOver="OnQueueDragOver" Drop="OnQueueDrop" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,104" Padding="20,9" CornerRadius="20"
                Background="{x:Static ui:Theme.Drawer}" Opacity="0" IsHitTestVisible="False">
            <TextBlock Text="{Binding Toast}" FontSize="13" />
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
            <Button Style="{StaticResource WindowButton}" Tag="{StaticResource I.Min}" Click="OnMinimize" AutomationProperties.Name="最小化" />
            <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Tag="{StaticResource I.Max}" Click="OnMaximize" AutomationProperties.Name="最大化" />
            <Button Style="{StaticResource CloseWindowButton}" Tag="{StaticResource I.Close}" Click="OnCloseWindow" AutomationProperties.Name="關閉" />
        </StackPanel>
    </Grid>
</Window>
