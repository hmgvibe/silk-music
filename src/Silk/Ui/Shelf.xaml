<UserControl x:Class="Silk.Ui.Shelf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Silk.Ui"
             Focusable="False">
    <StackPanel>
        <TextBlock x:Name="Header" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12" Visibility="Collapsed" />
        <Grid x:Name="Row" Background="Transparent" MouseEnter="OnRowHover" MouseLeave="OnRowHover">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" PreviewMouseWheel="OnWheel" ScrollChanged="OnScrollChanged">
                <ItemsControl x:Name="Items" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <Button x:Name="Back" Style="{StaticResource ShelfArrow}" Tag="{StaticResource I.Back}" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="-10,0,0,0" Click="OnBack" Visibility="Collapsed" AutomationProperties.Name="向左捲動" />
            <Button x:Name="Forward" Style="{StaticResource ShelfArrow}" Tag="{StaticResource I.Forward}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,0,14,0" Click="OnForward" Visibility="Collapsed" AutomationProperties.Name="向右捲動" />
        </Grid>
    </StackPanel>
</UserControl>
